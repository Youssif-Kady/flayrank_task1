      "source": [
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "# Creating a simulated ranked queue based on our defined actions\n",
        "data = {\n",
        "    'url': ['/product-a', '/blog/seo-guide', '/about-us', '/category/laptops', '/contact'],\n",
        "    'predicted_clicks': [1500, 850, 120, 500, 40],\n",
        "    'action_code': ['HIGH_IMPRESSIONS_LOW_CTR', 'SUDDEN_POSITION_DROP', 'STABLE_PERFORMANCE', 'HIGH_IMPRESSIONS_LOW_CTR', 'STABLE_PERFORMANCE'],\n",
        "    'priority': ['High', 'Medium', 'Low', 'High', 'Low']\n",
        "}\n",
        "\n",
        "df_action_queue = pd.DataFrame(data)\n",
        "\n",
        "# Ensure the output directory exists\n",
        "output_dir = 'work/outputs'\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "# Export the DataFrame to CSV\n",
        "csv_path = os.path.join(output_dir, 'w07_action_playbook_queue.csv')\n",
        "df_action_queue.to_csv(csv_path, index=False)\n",
        "\n",
        "print(f\"✅ Action queue exported successfully to: {csv_path}\")\n",
        "display(df_action_queue)"
      ],
